# ────────────────────────────────────────────────────────────
# DocDrift environment variables
# Copy this file to `.env.local` and fill in your real values.
# Never commit `.env.local`.
# ────────────────────────────────────────────────────────────

# Stripe secret key (server-side only). Starts with sk_test_ or sk_live_
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe publishable key (safe to expose to the browser). Starts with pk_test_ or pk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signing secret from `stripe listen` or the Stripe Dashboard. Starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Recurring Price IDs for each paid plan (create these in the Stripe Dashboard → Products).
# These are the `price_...` IDs, NOT product IDs.
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_TEAM=price_xxx

# The canonical URL of your site, used to build checkout success/cancel redirects.
# Local dev: http://localhost:3000   Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────
# Supabase (Project Settings → API)
# ────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe for the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only, NEVER exposed to the browser).
# Used by the seed script and trusted server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
